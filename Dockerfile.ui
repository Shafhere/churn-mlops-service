
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

COPY ui/requirements.txt requirements-ui.txt
RUN python -m pip install -r requirements-ui.txt

# UI imports the shared Pydantic input schema.
RUN mkdir -p /app/api
COPY api/__init__.py api/schemas.py ./api/
COPY ui/ ./ui/

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8501

CMD ["python", "-m", "streamlit", "run", "ui/app.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501", \
     "--server.headless=true"]
